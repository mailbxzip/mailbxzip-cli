<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        body { font-family: system-ui, Arial, sans-serif; margin: 0; padding: 1.5rem; color: #1a1a1a; background: #fafafa; }
        main { max-width: 70rem; margin: 0 auto; }
        h1 { font-size: 1.35rem; margin: 0 0 .25rem; }
        .count { color: #666; margin: 0 0 1.5rem; }
        .back { display: inline-block; margin-bottom: 1rem; color: #555; text-decoration: none; }
        .back:hover { text-decoration: underline; }
        table { border-collapse: collapse; width: 100%; background: #fff; border: 1px solid #ddd; border-radius: 6px; }
        th, td { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid #eee; vertical-align: top; }
        th { background: #f4f4f4; font-size: .85rem; text-transform: uppercase; letter-spacing: .03em; color: #555; }
        tr:last-child td { border-bottom: 0; }
        td.date { white-space: nowrap; color: #666; font-variant-numeric: tabular-nums; }
        .empty { color: #666; font-style: italic; }
        .pin { color: #a76b00; }
    </style>
</head>
<body>
<main>
    {% if parent is defined %}<a class="back" href="{{ parent }}">&larr; retour</a>{% endif %}

    <h1>{{ title }}</h1>

    {% if folders is defined %}
        <p class="count">{{ folders|length }} dossier(s), {{ total }} message(s)</p>
        {% if folders is empty %}
            <p class="empty">Aucun dossier.</p>
        {% else %}
        <table>
            <thead><tr><th>Dossier</th><th>Messages</th></tr></thead>
            <tbody>
            {% for folder in folders %}
                <tr>
                    <td><a href="{{ folder.href }}">{{ folder.name }}</a></td>
                    <td class="date">{{ folder.count }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    {% else %}
        <p class="count">{{ messages|length }} message(s)</p>
        {% if messages is empty %}
            <p class="empty">Aucun message dans ce dossier.</p>
        {% else %}
        <table>
            <thead><tr><th>Date</th><th>Correspondant</th><th>Objet</th></tr></thead>
            <tbody>
            {% for message in messages %}
                <tr>
                    <td class="date">{{ message.date }}</td>
                    <td>{{ message.from }}</td>
                    <td>
                        <a href="{{ message.href }}">{{ message.subject|default('(sans objet)') }}</a>
                        {% if message.attachments > 0 %}<span class="pin" title="{{ message.attachments }} pièce(s) jointe(s)">&#128206;</span>{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    {% endif %}
</main>
</body>
</html>
